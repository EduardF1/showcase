{
    "name": "eduardfischer/showcase-money-as-a-value-object",
    "description": "Money in minor units, with currency in the type.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.4"
    },
    "autoload": {
        "classmap": ["Money.php"]
    },
    "autoload-dev": {
        "psr-4": {
            "Showcase\\Money\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint": "php -l Money.php",
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
